{
  "version": 8,
  "name": "Ember Explore Light",
  "metadata": {
    "ember:note": "Seed for the /explore interactive map. Light warm terrain on wax — built for browsing/scanning, not focus (that's ember-topo). Import to Studio, tune, publish, then mirror the export back here. Ember (#d45a20) is deliberately absent: it is reserved for the selected cabin pin, which is DOM chrome, not a style layer. Roads read via VALUE contrast (dark taupe on wax), never hue — that is what keeps ember unspent. Green marks FOREST only; open land falls through to bare wax, so the greens are signal (where cabins are), not decoration."
  },
  "center": [-109.6, 47.0],
  "zoom": 5.6,
  "sprite": "mapbox://sprites/mapbox/light-v11",
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "sources": {
    "composite": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-terrain-v2,mapbox.mapbox-streets-v8"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#ede8dc" }
    },

    {
      "id": "landcover",
      "type": "fill",
      "source": "composite",
      "source-layer": "landcover",
      "maxzoom": 12,
      "filter": ["match", ["get", "class"], ["wood", "scrub", "snow"], true, false],
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "wood",
          "#c9d4b5",
          "scrub",
          "#e0e3d2",
          "snow",
          "#f6f3ea",
          "#e0e3d2"
        ],
        "fill-antialias": false,
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3,
          ["match", ["get", "class"], "wood", 0.55, "scrub", 0.3, 0.5],
          10,
          ["match", ["get", "class"], "wood", 0.5, "scrub", 0.25, 0.45],
          12,
          0
        ]
      }
    },
    {
      "id": "national-park",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse_overlay",
      "filter": ["==", ["get", "class"], "national_park"],
      "paint": {
        "fill-color": "#c2d1ab",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 4, 0.4, 10, 0.5]
      }
    },
    {
      "id": "landuse-wood",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse",
      "minzoom": 10,
      "filter": ["match", ["get", "class"], ["wood", "park"], true, false],
      "paint": {
        "fill-color": ["match", ["get", "class"], "wood", "#c9d4b5", "#cfdab8"],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0, 12, 0.5]
      }
    },
    {
      "id": "landuse-glacier",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse",
      "minzoom": 8,
      "filter": ["match", ["get", "class"], ["glacier", "sand", "rock"], true, false],
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "glacier",
          "#f6f3ea",
          "sand",
          "#f0e9d8",
          "#e6e0d1"
        ],
        "fill-opacity": 0.5
      }
    },

    {
      "id": "hillshade-shadow",
      "type": "fill",
      "source": "composite",
      "source-layer": "hillshade",
      "filter": ["==", ["get", "class"], "shadow"],
      "paint": {
        "fill-color": "#6b5f4a",
        "fill-antialias": false,
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["get", "level"],
          56,
          0.03,
          67,
          0.05,
          78,
          0.07,
          89,
          0.1,
          94,
          0.13
        ]
      }
    },
    {
      "id": "hillshade-highlight",
      "type": "fill",
      "source": "composite",
      "source-layer": "hillshade",
      "filter": ["==", ["get", "class"], "highlight"],
      "paint": {
        "fill-color": "#fffdf5",
        "fill-antialias": false,
        "fill-opacity": ["interpolate", ["linear"], ["get", "level"], 56, 0.05, 90, 0.14]
      }
    },

    {
      "id": "water",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "paint": { "fill-color": "#9fb9c7" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "composite",
      "source-layer": "waterway",
      "minzoom": 7,
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#9fb9c7",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.4, 12, 1.2, 16, 2.4]
      }
    },

    {
      "id": "contour",
      "type": "line",
      "source": "composite",
      "source-layer": "contour",
      "minzoom": 10,
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#b3a184",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0, 12, 0.3, 14, 0.4],
        "line-width": 0.7
      }
    },
    {
      "id": "contour-index",
      "type": "line",
      "source": "composite",
      "source-layer": "contour",
      "minzoom": 10,
      "filter": ["!=", ["get", "index"], null],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#a8967a",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0, 12, 0.45, 14, 0.6],
        "line-width": 1
      }
    },

    {
      "id": "trail",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 11,
      "filter": ["==", ["get", "class"], "path"],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#71805f",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 11, 0, 12.5, 0.9],
        "line-dasharray": [1, 1.6],
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.8, 14, 1.4, 16, 2.2]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 11,
      "filter": [
        "match",
        ["get", "class"],
        ["street", "street_limited", "service", "track", "road"],
        true,
        false
      ],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#bdb4a0",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 11, 0, 12.5, 1],
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.5, 14, 1.4, 16, 3]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 7,
      "filter": ["match", ["get", "class"], ["secondary", "tertiary"], true, false],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#a89e8a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.5, 10, 1, 14, 2, 16, 3.5]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 5,
      "filter": ["match", ["get", "class"], ["primary"], true, false],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#9a9078",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.6, 8, 1.2, 12, 2.2, 16, 4]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 4,
      "filter": ["match", ["get", "class"], ["motorway", "trunk"], true, false],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#8a7f6a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.8, 6, 1.4, 8, 2, 12, 3.2, 16, 6]
      }
    },

    {
      "id": "admin-state",
      "type": "line",
      "source": "composite",
      "source-layer": "admin",
      "filter": [
        "all",
        ["==", ["get", "admin_level"], 1],
        ["==", ["get", "maritime"], "false"],
        ["match", ["get", "worldview"], ["all", "US"], true, false]
      ],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#8a7f66",
        "line-opacity": 0.8,
        "line-dasharray": [4, 2],
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.8, 6, 1.4, 10, 2.2]
      }
    },
    {
      "id": "admin-country",
      "type": "line",
      "source": "composite",
      "source-layer": "admin",
      "filter": [
        "all",
        ["==", ["get", "admin_level"], 0],
        ["==", ["get", "maritime"], "false"],
        ["match", ["get", "worldview"], ["all", "US"], true, false]
      ],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#6f6552",
        "line-opacity": 0.9,
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 1, 6, 1.8, 10, 2.8]
      }
    },

    {
      "id": "contour-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "contour",
      "minzoom": 13,
      "filter": ["match", ["get", "index"], [5, 10], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["concat", ["to-string", ["round", ["*", ["get", "ele"], 3.28084]]], " ft"],
        "text-font": ["DIN Pro Regular", "Arial Unicode MS Regular"],
        "text-size": 9,
        "text-max-angle": 25,
        "symbol-spacing": 320,
        "text-padding": 6
      },
      "paint": {
        "text-color": "#9d8b6e",
        "text-halo-color": "#ede8dc",
        "text-halo-width": 1.4,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "trail-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 13,
      "filter": ["all", ["==", ["get", "class"], "path"], ["has", "name"]],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": 10,
        "text-max-angle": 30,
        "symbol-spacing": 350,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#5e6d4c",
        "text-halo-color": "#ede8dc",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "waterway-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "natural_label",
      "minzoom": 11,
      "filter": [
        "all",
        ["match", ["get", "class"], ["river", "stream"], true, false],
        ["<=", ["get", "filterrank"], 2]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["DIN Pro Italic", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 9, 15, 11],
        "text-max-angle": 30,
        "symbol-spacing": 400
      },
      "paint": {
        "text-color": "#5a8299",
        "text-halo-color": "#ede8dc",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "water-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "natural_label",
      "minzoom": 8,
      "filter": [
        "all",
        ["match", ["get", "class"], ["water", "reservoir", "bay", "sea"], true, false],
        ["<=", ["get", "filterrank"], 2]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["DIN Pro Italic", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 10, 14, 13],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#4f7a91",
        "text-halo-color": "#ede8dc",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "peak-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "natural_label",
      "minzoom": 11,
      "filter": [
        "all",
        ["==", ["get", "class"], "landform"],
        ["match", ["get", "maki"], ["mountain", "volcano"], true, false],
        ["<=", ["get", "filterrank"], 3]
      ],
      "layout": {
        "text-field": [
          "case",
          ["has", "elevation_ft"],
          [
            "concat",
            ["coalesce", ["get", "name_en"], ["get", "name"]],
            "\n",
            ["to-string", ["get", "elevation_ft"]],
            " ft"
          ],
          ["coalesce", ["get", "name_en"], ["get", "name"]]
        ],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 15, 12],
        "text-line-height": 1.2,
        "text-max-width": 8,
        "text-offset": [0, 0.4]
      },
      "paint": {
        "text-color": "#6b6250",
        "text-halo-color": "#ede8dc",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "park-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "poi_label",
      "minzoom": 6,
      "filter": ["all", ["==", ["get", "class"], "park_like"], ["<=", ["get", "filterrank"], 1]],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["DIN Pro Italic", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 10, 12, 13],
        "text-max-width": 8,
        "text-letter-spacing": 0.02
      },
      "paint": {
        "text-color": "#5a6b4b",
        "text-halo-color": "#ede8dc",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "settlement-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "filter": ["all",
        ["==", ["get", "class"], "settlement"],
        ["step", ["zoom"],
          ["<=", ["get", "symbolrank"], 8],
          5, ["<=", ["get", "symbolrank"], 10],
          7, ["<=", ["get", "symbolrank"], 11],
          9, ["<=", ["get", "symbolrank"], 12],
          11, ["<=", ["get", "symbolrank"], 13],
          13, ["<=", ["get", "symbolrank"], 15],
          15, true
        ]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 8, 12, 14, 15],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#5c5a4e",
        "text-halo-color": "#ede8dc",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "state-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "minzoom": 3,
      "maxzoom": 8,
      "filter": ["==", ["get", "class"], "state"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 9, 7, 13],
        "text-letter-spacing": 0.14,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#8d8672",
        "text-halo-color": "#ede8dc",
        "text-halo-width": 1.2
      }
    }
  ]
}
